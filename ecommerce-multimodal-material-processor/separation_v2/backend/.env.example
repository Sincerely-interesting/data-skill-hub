# VLM 视觉打标 (面壁 MiniCPM-O-4.5-9B omni 全模态，与 LLM 同端点/同模型)
VLM_BASE_URL=https://api.modelbest.cn/v1
VLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VLM_MODEL=MiniCPM-O-4.5-9B

# LLM 文本生成 (面壁 MiniCPM-O-4.5-9B omni 全模态)
LLM_BASE_URL=https://api.modelbest.cn/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=MiniCPM-O-4.5-9B

# 视频直传的素材可达基础 URL（可选）
# 远程 provider 无法直接读取本地视频文件，需把素材托管后填此处，
# 程序会自动拼成 {MEDIA_BASE_URL}/{素材ID}/{视频文件名} 作为 video_url。
# 留空：本地文件回退为 file:// 绝对路径（仅当 provider 与代码同机时有效）。
MEDIA_BASE_URL=

# 视频部件字段形态（可选，默认 openai_compatible）
# openai_compatible → {"type":"video_url","video_url":{"url":u}}   （URL 引用，端点需能 fetch）
# gemma_hf         → {"type":"video","video":u}                （Gemma HF Transformers 官方文档）
# gemini            → {"file_data":{"mime_type":"video/mp4","file_uri":u}}
# minicpm_base64   → {"type":"video_url","video_url":{"url":"data:video/mp4;base64,..."}} （面壁/MiniCPM-vLLM 官方 cookbook，整段视频 base64 内联，不抽帧）
VIDEO_PAYLOAD_FORMAT=minicpm_base64

# 请求体上限与自适应压缩（修复打标 413 request_too_large）
# 视频 base64 内联 + 多图叠加易超 ModelBest ~8-10MB 上限；开启后发请求前自动压缩，
# 且 413 不再重试直接失败，避免空烧额度。
MAX_REQUEST_MB=20
AUTO_COMPRESS_OVERSIZE=true
FFMPEG_PATH=

# 归档模板选择（可选，默认 storyboard）
# storyboard      → docs/STORYBOARD_TEMPLATE_STANDARD.md（视频分镜头脚本标准格式，用于"还原成视频原文"）
# full_dimension → docs/ANALYSIS_TEMPLATE_FULL_DIMENSION.md（商品素材全维内容理解分析）
ARCHIVE_TEMPLATE=storyboard