# 薄壳客户端配置 —— 只填两个必填参数，其余可选。
# 本客户端不持有任何模型密钥；所有打标在服务端完成。

# ===== 必填 =====
# 后端网关公网地址（由服务提供商下发）
GATEWAY_BASE_URL=http://119.91.111.63:8080
# 服务提供商下发的凭证 token
CREDENTIAL=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选（仅客户端预检提示，服务端为权威强制方）=====
# 一组图片上限三态：留空=无上限 / 0=禁止图片 / 正整数=上限张数
MAX_IMAGES_PER_GROUP=
# 图片压缩预算（MB），0 表示不压缩（服务端也会按自身限制压缩）
COMPRESS_BUDGET_MB=0
# ffmpeg 路径（视频处理用），留空用 PATH 中的 ffmpeg
FFMPEG_PATH=
# 压缩包本地预检上限（MB），0 表示不限制；服务端另有强制上限 max_package_size_mb
MAX_PACKAGE_SIZE_MB=0
# 分块上传：单块失败重试次数 + 指数退避基数（秒）。应对 1M 慢链路某块被反代 RST 时只重传该块。
CHUNK_RETRY=5
CHUNK_BACKOFF=1.5
