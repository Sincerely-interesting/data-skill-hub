# ============================================
# 电商多模态素材处理 - 环境配置模板
# 复制本文件为 .env 后填入真实值
# ============================================

# VLM 视觉打标（看图打标 / 归档看图）
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# LLM 文本生成（报告 / 分析）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 视频直传的素材可达基础 URL（可选）
# 远程 provider 无法直接读取本地视频文件时，把素材托管后填此处，
# 程序会自动拼成 {MEDIA_BASE_URL}/{素材ID}/{视频文件名} 作为 video_url。
# 留空则本地文件回退为 file:// 绝对路径（仅 provider 与代码同机时有效）。
MEDIA_BASE_URL=
