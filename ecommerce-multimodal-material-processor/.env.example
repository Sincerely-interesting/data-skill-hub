# ============================================
# 电商多模态素材处理 - 环境配置模板
# 复制本文件为 .env 后填入真实值
# ============================================

# VLM 视觉打标（看图打标 / 归档看图）
VLM_BASE_URL=https://api.modelbest.cn/v1
VLM_API_KEY=
VLM_MODEL=MiniCPM-V-4.5-9B

# LLM 文本生成（报告 / 分析）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 视频直传的素材可达基础 URL（可选）
# 远程 provider 无法直接读取本地视频文件时，把素材托管后填此处，
# 程序会自动拼成 {MEDIA_BASE_URL}/{素材ID}/{视频文件名} 作为 video_url。
# 留空则本地文件回退为 file:// 绝对路径（仅 provider 与代码同机时有效）。
MEDIA_BASE_URL=

# 视频部件字段形态（可选，默认 openai_compatible）
# openai_compatible → {"type":"video_url","video_url":{"url":u}}   （URL 引用，端点需能 fetch）
# gemma_hf         → {"type":"video","video":u}                （Gemma HF Transformers 官方文档）
# gemini            → {"file_data":{"mime_type":"video/mp4","file_uri":u}}
# minicpm_base64   → {"type":"video_url","video_url":{"url":"data:video/mp4;base64,..."}} （面壁/MiniCPM-vLLM，整段视频 base64 内联，不抽帧）
VIDEO_PAYLOAD_FORMAT=minicpm_base64

# ---- 请求体上限与自适应压缩（修复打标 HTTP 413 request_too_large）----
# minicpm_base64 把整段视频 base64 内联，叠加多张图片后极易超过端点请求体上限
# （如 ModelBest ~8-10MB），返回 413。开启自动压缩后，程序会在发请求前：
#   · 视频：用 ffmpeg 整段重编码（降分辨率+限码率，不抽帧）压到预算内
#   · 图片：用 Pillow 降分辨率重压 JPEG
# 且 413 被视为不可重试，直接失败，不再空烧 5 次指数退避浪费额度。
MAX_REQUEST_MB=8                 # 单次请求体软上限(MB)，留余量应对端点硬限
AUTO_COMPRESS_OVERSIZE=true      # 是否在超限时自动压缩视频/图片
FFMPEG_PATH=                     # ffmpeg 可执行路径（留空则用 PATH 中的 ffmpeg）

# 归档模板选择（可选，默认 storyboard）
# storyboard      → docs/STORYBOARD_TEMPLATE_STANDARD.md（视频分镜头脚本标准格式，用于"还原成视频原文"）
# full_dimension → docs/ANALYSIS_TEMPLATE_FULL_DIMENSION.md（商品素材全维内容理解分析）
ARCHIVE_TEMPLATE=storyboard
