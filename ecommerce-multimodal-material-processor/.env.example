# ============================================
# 电商多模态素材处理 Skill - 环境配置
# ============================================
# 复制此文件为 .env 并填入实际值

# ---- Provider API Keys (至少配置一个) ----

# MiniMax (官方云端API)
MINMAX_API_KEY=your_minmax_api_key_here

# Kimi (Moonshot)
KIMI_API_KEY=your_kimi_api_key_here

# MINICPM (快速打标)
MINICPM_API_KEY=your_minicpm_api_key_here
MINICPM_BASE_URL=https://api.minicpm.com/v1
MINICPM_INSTRUCT_MODEL_ID=minicpm-v-4

# PaddlePaddle (飞桨千帆)
PADDLE_API_KEY=your_paddle_api_key_here

# Custom/Private Deployment (如 Gemma-4)
CUSTOM_MINMAX_API_KEY=your_custom_key_here
CUSTOM_MINMAX_URL=https://your-private-endpoint/v1

# YesCode Proxy (Gemini)
YESCODE_API_KEY=your_yescode_key_here

# Gemini Direct
GEMINI_API_KEY=your_gemini_key_here

# ---- Processing Parameters ----

# Image processing
IMAGE_MAX_SIZE=768
IMAGE_QUALITY=75

# Batch processing defaults
DEFAULT_BATCH_SIZE=5
DEFAULT_BATCH_DELAY=20.0
DEFAULT_WORKERS=5

# Retry settings
MAX_RETRIES=5
RETRY_BASE_DELAY=10  # seconds, will use exponential backoff: 10s, 20s, 40s, 80s, 160s

# Quota exhaustion wait time (in hours)
QUOTA_WAIT_HOURS=5

# Output directories
ARCHIVE_OUTPUT_DIR=material_archives
EXCEL_EXPORT_DIR=excel_exports
CACHE_DIR=./cache

# Search service configuration
SEARCH_SERVICE_HOST=127.0.0.1
SEARCH_SERVICE_PORT=8000

# Quality thresholds
QUALITY_OTHER_LABEL_THRESHOLD=0.20  # Alert if "other" label > 20%
QUALITY_MIN_SUCCESS_RATE=0.95       # Alert if success rate < 95%

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO