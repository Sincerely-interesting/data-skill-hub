# ============================================
# 电商多模态素材处理 Skill - 环境配置模板
# ============================================

# ---- 一、AI模型提供商 ----
CUSTOM_MINMAX_URL=https://your-server/v1
# CUSTOM_MINMAX_API_KEY=your-api-key-here
# MINMAX_API_KEY=your-minmax-key-here
# KIMI_API_KEY=your-kimi-key-here
# MINICPM_API_KEY=your-minicpm-key-here
# PADDLE_API_KEY=your-paddle-key-here
# YESCODE_API_KEY=your-yescode-key-here
# GEMINI_API_KEY=your-gemini-key-here

# ---- 二、VLM配置 ----
VLM_MODEL=your-vlm-model
VLM_PROVIDER=your-vlm-provider
VLM_TEMPERATURE=0.3
VLM_MAX_TOKENS=4000
VLM_TIMEOUT_MS=300000

# ---- 三、LLM参数 ----
LLM_MODEL=your-llm-model
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2600
LLM_CONCURRENCY=1
ENABLE_MOCK_LLM=false
ENABLE_FALLBACK=true

# ---- 四、分析模板 ----
ANALYSIS_TEMPLATE=full_dimension
VIDEO_DIRECT_MODE=true

# ---- 五、处理限制 ----
MAX_IMAGES=10
MAX_VIDEOS=3
MAX_TAGS=8

# ---- 六、安全控制 ----
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_TYPES=.jpg,.jpeg,.png,.webp,.gif
ALLOWED_VIDEO_TYPES=.mp4,.mov,.avi,.mkv
THRESHOLD_STRONG=80.0
THRESHOLD_MEDIUM=60.0
THRESHOLD_WEAK=40.0

# ---- 七、性能调优 ----
API_TIMEOUT_SECONDS=30
DEFAULT_BATCH_SIZE=5
MAX_RETRIES=5

# ---- 八、日志 ----
LOG_LEVEL=INFO